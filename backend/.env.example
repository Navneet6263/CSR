PORT=5000
NODE_ENV=development
TRUST_PROXY=1
DB_SERVER=<your_db_server_ip>
DB_HOST=<your_db_host>
DB_USER=<your_db_username>
DB_PASSWORD=<your_db_password>
DB_DOMAIN=
DB_NAME=ScholarshipDB
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
DB_POOL_MIN=2
DB_POOL_MAX=15
JWT_SECRET=<your_strong_jwt_secret_min_32_chars>
JWT_REFRESH_SECRET=<a_different_strong_secret_min_32_chars>
PII_ENCRYPTION_KEY=<a_separate_random_32_byte_or_longer_secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
PRIVATE_UPLOAD_ROOT=./private_uploads
API_URL=http://localhost:5000
LOG_LEVEL=info
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FRONTEND_URL=http://localhost:3000
TERMS_VERSION=privacy-1.0-2024-01
SMTP_HOST=<smtp_host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp_username>
SMTP_PASS=<smtp_password>
SMTP_FROM=TalentBridge <no-reply@example.org>

# Development seed command only; never reuse this password.
SEED_PASSWORD=<minimum_12_character_development_password>
